# PostgreSQL Production Database URL (Use Supabase Connection Pooler for IPv4: e.g. aws-0-...pooler.supabase.com:6543/postgres)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

PORT=5000
DATABASE_SSL=true
NODE_ENV=production
ENABLE_SEED=false
FRONTEND_URL=https://prime-plate-chi.vercel.app

# Transactional Email Provider (Resend / SendGrid API)
EMAIL_PROVIDER_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@your-domain.com

# Cryptographically strong 256-bit keys (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_256_bit_random_hex_string_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_256_bit_random_hex_string_here

RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
